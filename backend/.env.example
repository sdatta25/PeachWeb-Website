EMAIL_USER=peachwebdevelopment@gmail.com
EMAIL_PASS=your_gmail_app_password_here
# Peachy chatbot. Free key from https://aistudio.google.com/apikey (no credit card).
# Set it on the host (e.g. Render > Environment), never in the frontend.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: one model ID, or a comma-separated list tried in order (a retired or
# out-of-quota model falls through to the next). Default is set in server.js.
# GEMINI_MODEL=gemini-2.5-flash-lite,gemini-flash-lite-latest,gemini-flash-latest
# Optional: max chat messages per visitor IP per minute (default 10).
# CHAT_RATE_PER_MIN=10
PORT=3002
INQUIRY_INBOX=peachwebdevelopment@gmail.com

# Email transport. The first one configured wins: gmail > resend > smtp.
# Gmail API over HTTPS — sends as EMAIL_USER, works on hosts that block SMTP ports.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# Optional alternatives
# RESEND_API_KEY=your_resend_api_key_here
# MAIL_FROM=PeachWeb <hello@yourdomain.com>
ADMIN_KEY=pick_a_long_random_string
MAIL_RELAY_URL=https://your-site.vercel.app/api/send-email
MAIL_RELAY_SECRET=the_same_secret_as_the_relay
